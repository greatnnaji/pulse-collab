# --- Database (local docker-compose) ---
POSTGRES_DB=pulsedb
POSTGRES_USER=pulseuser
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Database (hosted, e.g. Neon) ---
# Overrides the URL built from POSTGRES_HOST/PORT/DB. Use the direct host, not the
# -pooler one, so Flyway migrations run reliably. POSTGRES_USER/PASSWORD above must
# be set to the hosted credentials.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require

# --- Auth ---
# Use a long random value in production (e.g. `openssl rand -base64 48`).
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRATION=86400000

# --- CORS ---
# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Seed script (scripts/seed-demo-data.mjs) ---
# API_BASE_URL=http://localhost:8080/api
